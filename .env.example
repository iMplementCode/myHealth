# ============================================================
#  iMplement ERP — Environment configuration (example)
# ------------------------------------------------------------
#  Copy this file to `.env` and fill in your real values.
#  NEVER commit the real .env — it holds credentials.
#
#  This file belongs beside config.php in the application root,
#  which is ABOVE the document root. If you can fetch it with a
#  browser, it is in the wrong place and the database password
#  is public. See docs/DEPLOYMENT.md.
# ============================================================

# ── Where the served files are ───────────────────────────────
# Leave this unset and the application serves from ./public,
# which is right for a host where you control the document root.
#
# Set it only when the document root cannot be moved and you had
# to copy public/ into it — cPanel's primary domain, typically:
#
#   PUBLIC_PATH=/home/YOURACCOUNT/public_html
#
# Then re-copy public/ on every deployment, or the site keeps
# running yesterday's pages. A symlink avoids that; see
# deploy/cpanel-layout.sh.
#PUBLIC_PATH=

# Database (PostgreSQL)
#
# This is the tenant boundary: one shop per database, and DB_NAME
# is the whole of what decides which shop a container serves. See
# docs/MULTI_TENANT.md, and deploy/new-tenant.php to create one.
#
# DB_DATABASE / DB_USERNAME / DB_PASSWORD are accepted as aliases,
# because a hosting panel's PHP preset fills in Laravel's names and
# an unread password is a silent outage: libpq is handed nothing,
# the log says "fe_sendauth: no password supplied", and the browser
# says only that the service is unavailable.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=runai_technologies
DB_USER=runai_app
DB_PASS=change-me

# Seconds to wait for a connection before giving up. Keep it short.
# There are only a handful of PHP workers, and a database that is
# not answering will otherwise hold every one of them on the OS TCP
# timeout — minutes — which is a site that has stopped rather than a
# site showing an error.
DB_CONNECT_TIMEOUT=5

# ── Till receipts ────────────────────────────────────────────
# The width of the thermal roll the shop's printer takes, in
# millimetres. 80 is what almost every retail printer uses; 58 is
# the small handheld sort.
#
# Getting this wrong does not fail loudly — it prints a receipt
# wider than the paper and the right-hand column, which is the
# amounts, runs off the edge. Set it once to match the printer.
# A single receipt can be printed at the other width by adding
# ?w=58 (or ?w=80) to the URL.
RECEIPT_WIDTH_MM=80

# ── Migrations at start-up ───────────────────────────────────
# The container's start command runs database_structure/migrate.php
# before the web server begins listening, so a deploy can never leave
# the schema behind the code. Neither of these normally needs
# changing.
#
# MIGRATE_DB_WAIT   seconds to keep retrying while the database
#                   container is still coming up. Costs nothing when
#                   the database is already there. Every second of it
#                   is a second before the site is up, so it is a
#                   budget, not a guarantee. 0 disables the wait.
# MIGRATE_LOCK_WAIT seconds to wait for another container that is
#                   already applying migrations — a rolling deploy
#                   briefly runs two. Timing out here is not a
#                   failure: the other one is doing the work.
MIGRATE_DB_WAIT=20
MIGRATE_LOCK_WAIT=30

# Application
APP_ENV=production          # production | development
APP_DEBUG=false             # true shows detailed errors (dev only)
APP_TIMEZONE=Africa/Nairobi

# E-commerce integration
# Shared secret for the website order intake endpoint (api/orders.php).
# Leave empty to keep the endpoint disabled.
ORDERS_API_KEY=

# Storefront catalogue API (api/products.php)
# Public absolute base URL of this ERP — no trailing slash, and the
# scheme customers really browse with.
#
# It builds absolute image URLs for the catalogue, and it is also
# where a password-reset link points. That second use makes it
# something to get right: a reset link must never be built from the
# Host header, because the header is whatever the caller sent and a
# link pointing at somebody else's server is a handed-over account.
# With this empty the application falls back to APP_HOSTS, and with
# neither set it refuses to send the link at all.
APP_PUBLIC_URL=
# Optional: require this key (X-Api-Key header) for the catalogue API.
# Leave empty for a public read endpoint.
CATALOG_API_KEY=
# CORS origin allowed to fetch the catalogue from a browser (e.g. https://shop.example.com).
# Defaults to * for GET when empty.
WEB_ORIGIN=

# ─── Security ───────────────────────────────────────────────
# Redirect http:// to https:// and send HSTS. Leave true in
# production; localhost and private addresses are exempt anyway.
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000
HSTS_PRELOAD=false

# Hostnames this application answers to, comma separated. Anything
# else is refused — that is what stops a forged Host header ending
# up in a redirect or a password-reset link.
APP_HOSTS=

# CIDRs allowed to set the client IP (CF-Connecting-IP,
# X-Forwarded-For). Your CDN or load balancer, and nothing else.
# Empty means those headers are ignored entirely, which is the safe
# default for a server exposed directly.
# Cloudflare's current list: https://www.cloudflare.com/ips/
TRUSTED_PROXIES=

# Send the content security policy without enforcing it, to watch
# for breakage before turning it on.
CSP_REPORT_ONLY=false
CSP_REPORT_URI=

# Sessions in PostgreSQL rather than local files. Required for more
# than one application server.
SESSION_DRIVER_DB=true

IDLE_TIMEOUT_MINUTES=30
IDLE_WARNING_SECONDS=60

# Failed sign-ins from one address before it is held off, per
# lockout window. Per-account is LOGIN_MAX_ATTEMPTS in config.php.
LOGIN_MAX_ATTEMPTS_PER_IP=20
PASSWORD_MIN_LENGTH=12

# Gates /health.php?deep=1, sent as X-Health-Token. Leave empty and
# the deep check is open — fine when only your load balancer can
# reach the origin.
HEALTH_TOKEN=

# Subresource-integrity hash pinning the CDN copy of Chart.js.
# Printed by deploy/vendor-assets.sh. Unnecessary once that script
# has vendored the file locally.
CHART_JS_SRI=

# ─── Mail ────────────────────────────────────────────────────
# The application had no way to send email until sign-in codes
# needed one. PHP's mail() is not an option on a container — it
# shells out to sendmail and there is no MTA — so this speaks
# SMTP to a real mailbox.
#
# Note for .env files specifically: a value containing spaces
# must be quoted, or the parser stops with "unexpected
# whitespace". In a hosting panel's environment editor, paste the
# value plain — no quotes.
#
# Prove it before relying on it:
#     php deploy/check-mail.php you@yourdomain.co.ke
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
SMTP_TIMEOUT=10
MAIL_FROM=
MAIL_FROM_NAME="iMplement ERP"

# ─── Two-factor sign-in ──────────────────────────────────────
# A six-digit code emailed at sign-in, on top of the password.
#
# OFF by default, and it stays off by itself when mail is not
# configured or the migrations have not been run — because a code
# that cannot be delivered locks every single person out of the
# business at once. It says so in the error log when it does that.
#
# Turn it on only after deploy/check-mail.php has put a real
# message in a real inbox. This is an environment variable and not
# a code constant for one reason: when the mail server changes its
# password on a Friday night, somebody has to be able to set this
# back to false and have the shop working again without waiting
# for a deploy.
TWO_FACTOR_ENABLED=false
TWO_FACTOR_CODE_TTL=600
TWO_FACTOR_MAX_ATTEMPTS=5
TWO_FACTOR_RESEND_COOLDOWN=60

# ─── Forgotten passwords ─────────────────────────────────────
# No variable of its own. It needs the mail settings above and
# APP_PUBLIC_URL (or APP_HOSTS), and it switches itself off — and
# says so on the page — when they are missing. There is no on/off
# flag because an undeliverable reset link inconveniences one
# person, where an undeliverable sign-in code closes the shop.
#
# Setting it up, and how to check it really works, is in
# docs/PASSWORD_RESET.md.
